{
  "manifest_version": 3,
  "name": "Submitify+",
  "version": "2.2.1",
  "description": "Paste-and-submit editor with a live verdict tracker for the Codeforces problem sidebar.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://codeforces.com/*",
    "https://*.codeforces.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://codeforces.com/*",
        "https://*.codeforces.com/*"
      ],
      "js": [
        "Submitify.js"
      ],
      "css": [
        "submitify.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "111"
}